#include <iostream>
#include <queue>
using namespace std;

const int MAX = 100;

int graph[MAX][MAX];
bool visited[MAX];
int n;

// BFS function
void BFS(int start) {
    queue<int> q;

    // Mark starting vertex as visited
    visited[start] = true;

    // Insert starting vertex into queue
    q.push(start);

    while (!q.empty()) {

        // Remove vertex from front
        int vertex = q.front();
        q.pop();

        // Print vertex
        cout << vertex << " ";

        // Visit all adjacent vertices
        for (int i = 0; i < n; i++) {
            if (graph[vertex][i] == 1 && !visited[i]) {

                visited[i] = true;
                q.push(i);
            }
        }
    }
}

int main() {
    int edges;
    int start;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> edges;

    // Initialize graph
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            graph[i][j] = 0;
        }
        visited[i] = false;
    }

    cout << "Enter edges (source destination):\n";

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;

        graph[u][v] = 1;
        graph[v][u] = 1;   // Undirected graph
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    cout << "\nBFS Traversal: ";
    BFS(start);

    cout << endl;

    return 0;
}
